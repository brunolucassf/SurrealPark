---
import Simbolo from '@/components/marca/Simbolo.astro';
import Wordmark from '@/components/marca/Wordmark.astro';
import LogoCompleto from '@/components/marca/LogoCompleto.astro';
---
<svg class="definicoes-da-loja" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="loja-volume" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity=".16" />
      <stop offset=".32" stop-color="#fff" stop-opacity="0" />
      <stop offset=".7" stop-color="#000" stop-opacity=".16" />
      <stop offset="1" stop-color="#000" stop-opacity=".46" />
    </linearGradient>
    <linearGradient id="loja-volume-vertical" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity=".1" />
      <stop offset=".55" stop-color="#000" stop-opacity="0" />
      <stop offset="1" stop-color="#000" stop-opacity=".38" />
    </linearGradient>
    <radialGradient id="loja-luz-dourada" cx=".18" cy=".12" r=".85">
      <stop offset="0" stop-color="#F0D49A" stop-opacity=".34" />
      <stop offset=".5" stop-color="#F0D49A" stop-opacity=".06" />
      <stop offset="1" stop-color="#F0D49A" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="loja-chao" cx=".5" cy=".5" r=".5">
      <stop offset="0" stop-color="#000" stop-opacity=".62" />
      <stop offset=".6" stop-color="#000" stop-opacity=".22" />
      <stop offset="1" stop-color="#000" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="loja-lente" x1="0" y1="0" x2=".4" y2="1">
      <stop offset="0" stop-color="#3A3540" />
      <stop offset=".55" stop-color="#121014" />
      <stop offset="1" stop-color="#2A2218" />
    </linearGradient>
    <linearGradient id="loja-metal" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity=".5" />
      <stop offset=".4" stop-color="#fff" stop-opacity="0" />
      <stop offset=".75" stop-color="#000" stop-opacity=".25" />
      <stop offset="1" stop-color="#fff" stop-opacity=".2" />
    </linearGradient>
    <symbol id="loja-simbolo" viewBox="0 0 215 164"><Simbolo /></symbol>
    <symbol id="loja-wordmark" viewBox="0 0 468 89"><Wordmark /></symbol>
    <symbol id="loja-logo" viewBox="0 0 468 293"><LogoCompleto /></symbol>
  </defs>
</svg>
