---
import { PRODUTOS, formatarPreco } from '@/data/loja';
---
<section class="container grade" aria-labelledby="titulo-produtos">
  <h2 class="t-h2" id="titulo-produtos">Produtos</h2>
  {PRODUTOS.length === 0 ? (
    <p class="t-body">Nenhum produto disponível agora.</p>
  ) : (
    <ul class="grade__lista" role="list">
      {PRODUTOS.map((produto) => (
        <li class="grade__item">
          <a class="grade__link" href={produto.href}>
            <span class="t-h4">{produto.nome}</span>
            <span class="t-mono">{formatarPreco(produto.precoEmCentavos)}</span>
            {produto.isEsgotado && <span class="t-label grade__selo">Esgotado</span>}
            <span class="link-texto">Ver produto</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</section>
