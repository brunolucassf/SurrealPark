---
import IlustracaoDeProduto from '@/components/loja/IlustracaoDeProduto.astro';
import { IS_DEMONSTRACAO } from '@/data/demonstracao';
import Preco from '@/components/loja/Preco.astro';
import { descreverDisponibilidade, type ProdutoDeTela } from '@/lib/loja';
import { formatarPreco } from '@/data/loja';
import './painel.css';

interface Props {
  produto: ProdutoDeTela;
  ordem: number;
}

const { produto, ordem } = Astro.props;
const [corPrincipal] = produto.cores;
const [fotoPrincipal] = produto.fotos;
const avisoDeDisponibilidade = descreverDisponibilidade(produto.disponibilidade);
const nomesDasCores = produto.cores.map((cor) => cor.nome).join(', ');
---
<li
  class="produto"
  data-produto
  data-categoria={produto.categoria}
  data-preco={produto.precoEmCentavos}
  data-ordem={ordem}
  data-slug={produto.slug}
  data-disponibilidade={produto.disponibilidade}
>
  <a class="produto__link" href={`/loja/${produto.slug}`} data-inclinavel>
    <div class="produto__vitrine" style={`--cor-vitrine:${corPrincipal?.base ?? 'var(--ink-800)'};view-transition-name:produto-${produto.slug}`}>
      {fotoPrincipal ? (
        <picture class="produto__foto-moldura">
          <img class="produto__foto" src={fotoPrincipal.url} alt={fotoPrincipal.alt} width={fotoPrincipal.largura} height={fotoPrincipal.altura} loading={ordem < 4 ? 'eager' : 'lazy'} decoding="async" />
        </picture>
      ) : produto.forma && corPrincipal ? (
        <IlustracaoDeProduto forma={produto.forma} cor={corPrincipal} class="produto__ilustracao" />
      ) : (
        <svg class="produto__reservado" viewBox="0 0 120 150" role="img" aria-label={`${produto.nome}, foto em breve`} preserveAspectRatio="xMidYMid slice">
          <rect width="120" height="150" fill="none" />
          <path d="M20 112 L48 70 L68 98 L82 80 L100 112 Z" fill="currentColor" opacity="0.18" />
          <circle cx="86" cy="44" r="9" fill="currentColor" opacity="0.18" />
        </svg>
      )}
      <span class="produto__brilho" aria-hidden="true"></span>
      {produto.isDestaque && <span class="produto__selo t-mono-xs">Destaque</span>}
      {avisoDeDisponibilidade && <span class="produto__disponibilidade t-mono-xs" data-disponibilidade-aviso>{avisoDeDisponibilidade}</span>}
      {IS_DEMONSTRACAO && produto.isExemplo && <span class="produto__exemplo selo-exemplo t-mono-xs">exemplo</span>}
    </div>
    <div class="produto__info">
      <h3 class="produto__nome">{produto.nome}</h3>
      <span class="produto__rodape">
        <span class="produto__preco-bloco" data-preco-bloco>
          <Preco precoEmCentavos={produto.precoEmCentavos} class="produto__preco" />
          {produto.precoDeEmCentavos !== null && (
            <>
              <s class="produto__preco-de"><span class="sr-only">Preço anterior </span>{formatarPreco(produto.precoDeEmCentavos)}</s>
              {produto.percentualDesconto !== null && <span class="produto__promocao t-mono-xs">-{produto.percentualDesconto}%</span>}
            </>
          )}
        </span>
        {produto.cores.length > 1 && (
          <span class="produto__cores">
            {produto.cores.map((cor) => <span class="produto__cor" style={`--cor-amostra:${cor.base}`}></span>)}
            <span class="sr-only">Cores: {nomesDasCores}</span>
          </span>
        )}
      </span>
    </div>
    <span class="produto__neon" aria-hidden="true"><span class="produto__neon-faixa"></span></span>
  </a>
</li>
