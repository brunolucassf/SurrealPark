---
import Peca from '@/components/loja/Peca.astro';
import type { CorDoProduto, FormaDoProduto, VistaDoProduto } from '@/data/loja';

interface Props {
  forma: FormaDoProduto;
  cor: CorDoProduto;
  vista?: VistaDoProduto;
  rotulo?: string;
  class?: string;
}

const { forma, cor, vista = 'frente', rotulo, class: className } = Astro.props;

const QUADRO_INTEIRO = '0 0 400 500';

const CORTE_DO_DETALHE: Record<FormaDoProduto, string> = {
  camiseta: '130 120 140 175',
  'camiseta-baby': '150 150 100 125',
  'camiseta-oversized': '96 140 208 260',
  jaqueta: '196 118 120 150',
  moletom: '130 100 140 175',
  saia: '70 330 120 150',
  short: '80 270 110 137.5',
  legging: '120 180 100 125',
  bone: '110 140 180 225',
  bucket: '130 200 140 175',
  oculos: '10 160 120 150',
  tenis: '135 225 140 175',
  copo: '110 200 180 225',
  'copo-termico': '110 200 180 225',
  chaveiro: '96 200 208 260',
  adesivos: '90 100 180 225',
};

const TRANSFORMACAO_DA_CAMISETA: Partial<Record<FormaDoProduto, string>> = {
  'camiseta-baby': 'translate(200 250) scale(.84 .8) translate(-200 -250)',
  'camiseta-oversized': 'translate(200 250) scale(1.1 1) translate(-200 -250)',
};

const isVestuarioComCostas = ['camiseta', 'camiseta-baby', 'camiseta-oversized', 'jaqueta', 'moletom'].includes(forma);
const isCostas = vista === 'costas' && isVestuarioComCostas;
const isCamiseta = forma.startsWith('camiseta');
const viewBox = vista === 'detalhe' ? CORTE_DO_DETALHE[forma] : QUADRO_INTEIRO;

const profundidadeDaGola = isCostas ? 96 : 114;
const corpoDaCamiseta = `M156 86 C170 ${profundidadeDaGola} 230 ${profundidadeDaGola} 244 86 L298 100 C316 106 330 116 342 132 L368 170 L326 204 L298 178 L296 420 C232 432 168 432 104 420 L102 178 L74 204 L32 170 L58 132 C70 116 84 106 102 100 Z`;
const corpoDeMangaLonga = 'M152 82 L248 82 L262 94 L314 110 C334 118 344 134 348 154 L376 372 L336 382 L308 206 L306 426 C238 436 162 436 94 426 L92 206 L64 382 L24 372 L52 154 C56 134 66 118 86 110 L138 94 Z';
const lenteEsquerda = 'M66 214 C66 192 86 184 126 184 L168 184 C186 184 192 196 190 212 L184 252 C180 276 162 288 132 288 C94 288 68 270 66 242 Z';
const LACES = [0, 1, 2, 3, 4].map((indice) => ({ x: 170 + indice * 24, y: 250 + indice * 7.5 }));
---
<svg
  class:list={['ip', className]}
  viewBox={viewBox}
  xmlns="http://www.w3.org/2000/svg"
  style={`--cor-padrao:${cor.base};--cor-estampa-padrao:${cor.estampa}`}
  role={rotulo ? 'img' : undefined}
  aria-label={rotulo}
  aria-hidden={rotulo ? undefined : 'true'}
  focusable="false"
>
  <ellipse class="ip-chao" cx="200" cy="474" rx="138" ry="14" fill="url(#loja-chao)" />
  <g class="ip-produto">
    {isCamiseta && (
      <g transform={TRANSFORMACAO_DA_CAMISETA[forma]}>
        <Peca d={corpoDaCamiseta} />
        {!isCostas && <path d="M156 86 C172 99 228 99 244 86 C230 114 170 114 156 86 Z" fill="#000" fill-opacity=".42" />}
        <path d={`M156 86 C170 ${profundidadeDaGola} 230 ${profundidadeDaGola} 244 86`} class="ip-gola" />
        <path d={`M163 90 C176 ${profundidadeDaGola + 2} 224 ${profundidadeDaGola + 2} 237 90`} class="ip-costura" />
        <path d="M102 178 C108 150 108 124 102 100 M298 178 C292 150 292 124 298 100" class="ip-dobra" />
        <path d="M328 197 L361 171 M72 197 L39 171 M106 410 C168 420 232 420 294 410" class="ip-costura" />
        <path d="M140 236 C150 300 146 360 136 412 M262 250 C254 320 262 380 272 414" class="ip-dobra ip-dobra--suave" />
        {!isCostas && forma === 'camiseta' && <use href="#loja-simbolo" class="ip-estampa" x="170" y="150" width="60" height="46" />}
        {!isCostas && forma === 'camiseta-baby' && <use href="#loja-simbolo" class="ip-estampa" x="172" y="160" width="56" height="43" />}
        {!isCostas && forma === 'camiseta-oversized' && <use href="#loja-logo" class="ip-estampa" x="120" y="166" width="160" height="100" />}
        {isCostas && <use href="#loja-logo" class="ip-estampa" x="115" y="150" width="170" height="106" />}
      </g>
    )}

    {(forma === 'jaqueta' || forma === 'moletom') && (
      <g>
        {forma === 'moletom' && !isCostas && <Peca d="M136 100 C132 72 164 58 200 58 C236 58 268 72 264 100 C246 88 154 88 136 100 Z" tom="escuro" />}
        <Peca d={corpoDeMangaLonga} />
        <path d="M92 206 C98 170 96 130 86 110 M308 206 C302 170 304 130 314 110" class="ip-dobra" />
        <Peca d="M336 382 L376 372 L380 404 L340 412 Z" tom="escuro" isComLuz={false} />
        <Peca d="M64 382 L24 372 L20 404 L60 412 Z" tom="escuro" isComLuz={false} />
        <Peca d="M94 426 C162 436 238 436 306 426 L306 448 C238 458 162 458 94 448 Z" tom="escuro" isComLuz={false} />
        <path d="M98 438 C164 447 236 447 302 438 M338 394 L378 386 M62 394 L22 386" class="ip-costura" />
        <path d="M150 230 C160 300 156 360 146 420 M254 240 C246 310 252 370 262 420" class="ip-dobra ip-dobra--suave" />
        {forma === 'jaqueta' && (
          <Fragment>
            <Peca d="M152 82 L248 82 L262 94 L250 124 L200 112 L150 124 L138 94 Z" tom="escuro" />
            {!isCostas && (
              <Fragment>
                <path d="M200 112 L200 426" class="ip-ziper" />
                <path d="M200 112 L200 426" class="ip-ziper-dentes" />
                <rect x="194.5" y="124" width="11" height="24" rx="3" class="ip-metal" />
                <path d="M118 334 L150 300 M282 334 L250 300" class="ip-dobra" />
                <use href="#loja-simbolo" class="ip-estampa" x="232" y="150" width="44" height="34" />
              </Fragment>
            )}
            {isCostas && <use href="#loja-logo" class="ip-estampa" x="115" y="160" width="170" height="106" />}
          </Fragment>
        )}
        {forma === 'moletom' && !isCostas && (
          <Fragment>
            <path d="M156 88 C164 112 236 112 244 88 C232 100 168 100 156 88 Z" fill="#000" fill-opacity=".45" />
            <path d="M184 108 C182 140 180 168 178 192 M216 108 C218 140 220 168 222 192" class="ip-cordao" />
            <circle cx="178" cy="196" r="3.5" class="ip-metal" />
            <circle cx="222" cy="196" r="3.5" class="ip-metal" />
            <path d="M132 318 L268 318 L292 400 L108 400 Z" fill="#000" fill-opacity=".1" />
            <path d="M132 318 L268 318 L292 400 L108 400 Z" class="ip-dobra" />
            <path d="M136 324 L264 324" class="ip-costura" />
            <use href="#loja-simbolo" class="ip-estampa" x="170" y="168" width="60" height="46" />
          </Fragment>
        )}
        {forma === 'moletom' && isCostas && (
          <Fragment>
            <Peca d="M140 92 C132 60 166 46 200 46 C234 46 268 60 260 92 C252 150 148 150 140 92 Z" tom="escuro" />
            <path d="M200 50 L200 134" class="ip-costura" />
            <use href="#loja-logo" class="ip-estampa" x="125" y="200" width="150" height="94" />
          </Fragment>
        )}
      </g>
    )}

    {forma === 'saia' && (
      <g>
        <Peca d="M142 96 L258 96 L260 126 C290 220 312 330 330 430 C250 452 150 452 70 430 C88 330 110 220 140 126 Z" />
        <Peca d="M142 96 L258 96 L260 126 L140 126 Z" tom="escuro" isComLuz={false} />
        <path d="M170 128 C160 250 150 350 136 444 M200 128 L200 450 M230 128 C240 250 250 350 264 444" class="ip-dobra ip-dobra--suave" />
        <path d="M76 420 C152 440 248 440 324 420 M144 111 L256 111" class="ip-costura" />
        <use href="#loja-simbolo" class="ip-estampa" x="108" y="370" width="44" height="34" />
      </g>
    )}

    {forma === 'short' && (
      <g>
        <Peca d="M118 120 L282 120 L286 152 C298 230 310 300 322 368 L222 382 L204 238 L196 238 L178 382 L78 368 C90 300 102 230 114 152 Z" />
        <Peca d="M118 120 L282 120 L286 152 L114 152 Z" tom="escuro" isComLuz={false} />
        <path d="M196 152 C190 175 186 190 182 204 M204 152 C210 175 214 190 218 204" class="ip-cordao" />
        <path d="M200 152 L200 238" class="ip-dobra" />
        <path d="M84 356 L176 368 M224 368 L316 356 M120 136 L280 136" class="ip-costura" />
        <use href="#loja-simbolo" class="ip-estampa" x="110" y="296" width="50" height="38" />
      </g>
    )}

    {forma === 'legging' && (
      <g>
        <Peca d="M142 54 L258 54 L262 86 C266 200 262 330 256 456 L214 458 L204 196 L196 196 L186 458 L144 456 C138 330 134 200 138 86 Z" />
        <Peca d="M142 54 L258 54 L262 86 L138 86 Z" tom="escuro" isComLuz={false} />
        <path d="M200 86 L200 196 M166 220 C160 320 162 400 166 456" class="ip-dobra ip-dobra--suave" />
        <path d="M144 70 L256 70 M146 448 L184 450 M216 450 L254 448" class="ip-costura" />
        <use href="#loja-simbolo" class="ip-estampa" x="148" y="206" width="40" height="31" />
        <g transform="translate(246 236) rotate(90)">
          <use href="#loja-wordmark" class="ip-estampa" x="0" y="0" width="150" height="28.5" />
        </g>
      </g>
    )}

    {forma === 'bone' && (
      <g transform="translate(0 -10)">
        <Peca d="M92 300 C88 196 146 132 200 132 C254 132 312 196 308 300 C250 312 150 312 92 300 Z" />
        <path d="M200 134 C168 172 150 240 146 304 M200 134 C232 172 250 240 254 304" class="ip-dobra" />
        <circle cx="150" cy="186" r="3" fill="#000" fill-opacity=".5" />
        <circle cx="250" cy="186" r="3" fill="#000" fill-opacity=".5" />
        <use href="#loja-simbolo" class="ip-estampa" x="158" y="204" width="84" height="64" />
        <Peca d="M84 300 C150 292 250 292 316 300 C326 318 322 346 300 362 C260 384 140 384 100 362 C78 346 74 318 84 300 Z" tom="escuro" isComLuz={false} />
        <Peca d="M84 296 C150 288 250 288 316 296 C324 312 318 336 298 350 C256 372 144 372 102 350 C82 336 76 312 84 296 Z" />
        <path d="M94 306 C120 344 280 344 306 306 M98 318 C126 356 274 356 302 318" class="ip-costura" />
        <circle cx="200" cy="133" r="8" class="ip-base" />
        <circle cx="200" cy="133" r="8" fill="url(#loja-volume)" />
      </g>
    )}

    {forma === 'bucket' && (
      <g>
        <Peca d="M78 318 C96 296 304 296 322 318 L350 362 C330 386 70 386 50 362 Z" tom="escuro" />
        <Peca d="M118 318 L134 222 C140 196 260 196 266 222 L282 318 C240 330 160 330 118 318 Z" />
        <path d="M134 222 C144 204 256 204 266 222 C256 236 144 236 134 222 Z" fill="#fff" fill-opacity=".1" />
        <Peca d="M122 300 C170 310 230 310 278 300 L282 318 C240 330 160 330 118 318 Z" tom="escuro" isComLuz={false} />
        <Peca d="M84 326 C120 344 280 344 316 326 L350 362 C330 386 70 386 50 362 Z" />
        <circle cx="146" cy="244" r="4" class="ip-metal" />
        <circle cx="254" cy="244" r="4" class="ip-metal" />
        <path d="M58 360 C100 380 300 380 342 360 M66 350 C110 368 290 368 334 350" class="ip-costura" />
        <use href="#loja-simbolo" class="ip-estampa" x="170" y="246" width="60" height="46" />
      </g>
    )}

    {forma === 'oculos' && (
      <g transform="translate(200 250) scale(1.02) translate(-200 -250)">
        <path d="M66 204 L30 196 M334 204 L370 196" class="ip-haste" />
        <path d="M188 206 C196 192 204 192 212 206" class="ip-haste" />
        {[undefined, 'matrix(-1 0 0 1 400 0)'].map((transformacao) => (
          <g transform={transformacao}>
            <path d={lenteEsquerda} fill="url(#loja-lente)" />
            <path d="M84 208 C98 196 126 194 152 196" class="ip-reflexo" />
            <path d="M120 284 L176 200 L188 206 L140 288 Z" fill="#fff" fill-opacity=".06" />
            <path d={lenteEsquerda} class="ip-aro" />
            <path d={lenteEsquerda} class="ip-aro-brilho" />
          </g>
        ))}
        <use href="#loja-simbolo" class="ip-estampa" x="38" y="184" width="26" height="20" />
      </g>
    )}

    {forma === 'tenis' && (
      <g transform="translate(200 300) scale(1.12) translate(-200 -300)">
        <Peca d="M48 314 C44 290 46 262 58 246 C66 236 80 234 94 240 C112 248 132 248 150 236 L168 222 C176 218 184 220 186 228 L196 252 C230 262 290 278 330 290 C356 298 372 306 374 314 Z" />
        <path d="M58 246 C66 236 80 234 94 240 C112 248 132 248 150 236 C132 258 104 262 80 256 C70 254 62 250 58 246 Z" fill="#000" fill-opacity=".55" />
        <Peca d="M150 236 L168 222 C176 218 184 220 186 228 L196 252 C180 250 164 246 150 236 Z" tom="escuro" isComLuz={false} />
        <Peca d="M318 288 C350 296 370 304 374 314 L300 314 C304 302 310 294 318 288 Z" tom="escuro" isComLuz={false} />
        <Peca d="M48 314 C44 290 46 262 58 246 C68 254 76 282 78 314 Z" tom="escuro" isComLuz={false} />
        <path d="M156 246 C200 260 240 270 282 282" class="ip-ilhos" />
        {LACES.map(({ x, y }) => <path d={`M${x - 6} ${y - 9} L${x + 6} ${y + 7}`} class="ip-cadarco" />)}
        <path d="M54 304 C150 304 260 304 368 308" class="ip-costura" />
        <use href="#loja-simbolo" class="ip-estampa" x="180" y="276" width="48" height="36" />
        <Peca d="M40 330 C40 318 48 312 60 312 L338 312 C362 312 376 322 378 336 C380 352 368 362 346 362 L62 362 C48 362 40 352 40 340 Z" cor="#E9E2D4" isComLuz={false} />
        <path d="M44 330 L377 330" class="ip-dobra" />
        <path d="M56 352 L362 352" class="ip-sola" />
      </g>
    )}

    {forma === 'copo' && (
      <g>
        <Peca d="M122 128 L278 128 L262 424 C262 436 246 442 200 442 C154 442 138 436 138 424 Z" />
        <path d="M150 152 L162 152 L158 410 L152 410 Z M174 152 L178 152 L176 410 L174 410 Z" fill="#fff" fill-opacity=".2" />
        <path d="M118 128 C118 116 282 116 282 128 C282 140 118 140 118 128 Z" class="ip-base" />
        <path d="M118 128 C118 116 282 116 282 128 C282 140 118 140 118 128 Z" fill="#fff" fill-opacity=".22" />
        <path d="M128 128 C128 120 272 120 272 128 C272 135 128 135 128 128 Z" fill="#000" fill-opacity=".45" />
        <path d="M140 404 C170 412 230 412 260 404" class="ip-costura" />
        <use href="#loja-simbolo" class="ip-estampa" x="150" y="238" width="100" height="76" />
      </g>
    )}

    {forma === 'copo-termico' && (
      <g>
        <Peca d="M128 140 L272 140 L262 430 C262 440 248 446 200 446 C152 446 138 440 138 430 Z" tom="metal" />
        <path d="M152 160 L162 160 L158 420 L152 420 Z" fill="#fff" fill-opacity=".28" />
        <Peca d="M118 108 C118 96 282 96 282 108 L278 142 L122 142 Z" cor="#1A191C" isComLuz={false} />
        <path d="M118 108 C118 96 282 96 282 108 C282 118 118 118 118 108 Z" fill="#fff" fill-opacity=".12" />
        <path d="M228 104 C228 99 258 99 258 104 C258 109 228 109 228 104 Z" fill="#000" fill-opacity=".7" />
        <path d="M140 404 L260 404 M139 414 L261 414" class="ip-dobra" />
        <use href="#loja-simbolo" class="ip-estampa" x="155" y="250" width="90" height="69" />
      </g>
    )}

    {forma === 'chaveiro' && (
      <g>
        <circle cx="200" cy="112" r="40" class="ip-argola" />
        <circle cx="200" cy="112" r="40" class="ip-argola-brilho" />
        <ellipse cx="200" cy="196" rx="10" ry="34" class="ip-argola ip-argola--fina" />
        <Peca d="M76 300 C136 196 264 196 324 300 C264 404 136 404 76 300 Z" tom="metal" />
        <path d="M94 300 C150 214 250 214 306 300 C250 386 150 386 94 300 Z" class="ip-bisel" />
        <circle cx="200" cy="236" r="9" fill="#000" fill-opacity=".55" />
        <use href="#loja-simbolo" x="138" y="262" width="124" height="94" style="color:#000" opacity=".35" />
        <use href="#loja-simbolo" class="ip-estampa" x="136" y="259" width="124" height="94" />
      </g>
    )}

    {forma === 'adesivos' && (
      <g transform="rotate(-5 200 250)">
        <Peca d="M100 86 H300 Q314 86 314 100 V392 Q314 406 300 406 H100 Q86 406 86 392 V100 Q86 86 100 86 Z" />
        <circle cx="152" cy="160" r="48" fill="#fff" />
        <circle cx="152" cy="160" r="43" fill="#131215" />
        <use href="#loja-simbolo" x="118" y="134" width="68" height="52" style="color:#E6BD6E" />
        <path d="M206 170 C226 138 274 138 294 170 C274 202 226 202 206 170 Z" fill="#D6A24A" stroke="#fff" stroke-width="6" stroke-linejoin="round" />
        <rect x="110" y="236" width="180" height="48" rx="24" fill="#1A191C" stroke="#fff" stroke-width="5" />
        <use href="#loja-wordmark" x="132" y="247" width="136" height="26" style="color:#F2ECE2" />
        <path d="M150 304 L190 372 L110 372 Z" fill="#F2694E" stroke="#fff" stroke-width="6" stroke-linejoin="round" />
        <circle cx="252" cy="340" r="42" fill="#fff" />
        <circle cx="252" cy="340" r="37" fill="#C3CEDC" />
        <use href="#loja-simbolo" x="224" y="319" width="56" height="43" style="color:#1A191C" />
        <path d="M314 362 L314 392 Q314 406 300 406 L272 406 Z" fill="#000" fill-opacity=".35" />
        <path d="M272 406 L314 362 L300 398 Z" fill="#fff" fill-opacity=".85" />
      </g>
    )}
  </g>
</svg>
