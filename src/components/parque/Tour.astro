---
import CenaDoTour from './CenaDoTour.astro';
import { prepararTour } from './preparar-tour';
import { INDICE_DO_PARQUE } from '@/data/tour';

interface Props {
  alvosDepoisDoTour: string[];
}

const { alvosDepoisDoTour } = Astro.props;
const { cenas, motor } = await prepararTour();
const alvosExistentes = new Set([...cenas.map(({ cena }) => cena.ancora).filter(Boolean), ...alvosDepoisDoTour]);
const itensDoIndice = INDICE_DO_PARQUE.filter((item) => alvosExistentes.has(item.alvo));
const alvoDoPulo = alvosDepoisDoTour[0];
---
<div class="parque">
  <div class="parque__mapa" data-tour-mapa>
    <nav class="mapa" aria-label="Nesta página">
      <ol class="mapa__trilho" role="list" data-tour-mapa-trilho>
        {itensDoIndice.map((item) => (
          <li><a class="mapa__item t-label" href={`#${item.alvo}`} data-alvo={item.alvo}>{item.rotulo}</a></li>
        ))}
      </ol>
      {alvoDoPulo && (
        <a class="mapa__pular t-mono-xs" href={`#${alvoDoPulo}`}>
          Pular o tour
          <svg viewBox="0 0 10 10" width="10" height="10" aria-hidden="true" focusable="false"><path d="M5 1v8M1.5 5.5 5 9l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.2" /></svg>
        </a>
      )}
    </nav>
  </div>
  <div class="tour" data-tour>
    <div class="tour__palco" aria-hidden="true">
      <canvas class="tour__canvas" data-tour-canvas></canvas>
    </div>
    <div class="tour__cenas">
      {cenas.map((preparada) => <CenaDoTour preparada={preparada} />)}
    </div>
  </div>
  <slot />
</div>
<script type="application/json" data-tour-config set:html={JSON.stringify(motor)} />

<script>
  import { iniciarTourDoParque } from '@/scripts/parque/tour';
  iniciarTourDoParque();
</script>
