---
import { getImage } from 'astro:assets';
import EventoLinha from '@/components/eventos/EventoLinha.astro';
import Icone from '@/components/ui/Icone.astro';
import { PALCO_POR_ID, PALCOS } from '@/data/palcos';
import { IS_DEMONSTRACAO } from '@/data/demonstracao';
import { REDES, SUFIXO_NOVA_ABA } from '@/data/site';
import { buscarFotoPorSlot } from '@/lib/fotos';
import { listarProximosEventos, type Evento } from '@/lib/eventos';
import { isPainelConfigurado } from '@/lib/painel';

const LIMITE_DE_DATAS = 4;
const SLOT_NEUTRO_DA_LENTE = 'jardim-olho';
const eventos = (await listarProximosEventos()).slice(0, LIMITE_DE_DATAS);
const instagram = REDES.find((rede) => rede.nome === 'Instagram');

async function gerarUrlDaFoto(slotDaFoto: string): Promise<string | undefined> {
  const foto = buscarFotoPorSlot(slotDaFoto);
  if (!foto) return undefined;
  const imagem = await getImage({ src: foto.imagem, width: 440, format: 'avif', quality: 50 });
  return imagem.src;
}

async function gerarUrlDaLente(evento: Evento): Promise<string | undefined> {
  if (evento.flyerHover) return evento.flyerHover.url;
  if (evento.flyer) return evento.flyer.url;
  if (evento.data.imagem) return evento.data.imagem.src;
  const [primeiroPalco] = evento.data.palcos;
  return gerarUrlDaFoto(primeiroPalco ? PALCO_POR_ID[primeiroPalco].slotDaFoto : SLOT_NEUTRO_DA_LENTE);
}

async function gerarLenteDeReserva(chave: string, slotDaFoto: string): Promise<[string, string | undefined]> {
  return [chave, await gerarUrlDaFoto(slotDaFoto)];
}

async function gerarLentesDeReserva(): Promise<Record<string, string>> {
  const entradas = await Promise.all([
    ...PALCOS.map((id) => gerarLenteDeReserva(id, PALCO_POR_ID[id].slotDaFoto)),
    gerarLenteDeReserva('neutro', SLOT_NEUTRO_DA_LENTE),
  ]);
  const comUrl = entradas.filter((entrada): entrada is [string, string] => entrada[1] !== undefined);
  return Object.fromEntries(comUrl);
}

const urlsDasLentes = await Promise.all(eventos.map(gerarUrlDaLente));
const lentesDeReserva = isPainelConfigurado ? await gerarLentesDeReserva() : {};
const assinaturaDoSnapshot = eventos.map((evento) => evento.assinatura ?? '').join('|');
---
<section class="datas" id="proximas-datas" aria-labelledby="titulo-datas" data-datas data-humor="datas" data-assinatura={assinaturaDoSnapshot} data-demo={String(IS_DEMONSTRACAO)} data-lentes-de-reserva={JSON.stringify(lentesDeReserva)}>
  <div class="datas__aurora" aria-hidden="true" data-datas-aurora>
    <span class="datas__veu datas__veu--ouro"></span>
    <span class="datas__veu datas__veu--ambar"></span>
    <span class="datas__veu datas__veu--lua"></span>
    <span class="datas__onda"></span>
    <span class="datas__foco" data-datas-foco></span>
  </div>
  <div class="container">
    <header class="datas__topo">
      <h2 class="t-h2" id="titulo-datas" data-revela-titulo>Próximas datas</h2>
      <a class="link-nav t-label datas__todas" href="/programacao">
        Ver programação completa
        <Icone nome="piramide" class="btn__seta" />
      </a>
    </header>
    <ol class="datas__lista" role="list" data-datas-lista hidden={eventos.length === 0}>
      {eventos.map((evento, indice) => (
        <li data-revela><EventoLinha evento={evento} urlDaLente={urlsDasLentes[indice]} /></li>
      ))}
    </ol>
    <div class="datas__vazio" data-datas-vazio hidden={eventos.length > 0}>
      <p class="t-lead">Novas datas em breve. Elas saem primeiro no Instagram.</p>
      {instagram && (
        <a class="btn btn--secundario" href={instagram.href} target="_blank" rel="noopener">
          Seguir no Instagram<span class="sr-only"> {SUFIXO_NOVA_ABA}</span>
        </a>
      )}
    </div>
  </div>
  <div class="lente" aria-hidden="true" data-lente-flutuante><img alt="" width="220" height="275" decoding="async" /></div>
</section>

<script>
  import { iniciarEventosDaHome } from '@/scripts/eventos-api';
  void iniciarEventosDaHome();
</script>

<style>
  .datas {
    position: relative;
    z-index: 2;
    padding-block: var(--s-section);
  }
  :global(.pin-ok) .datas {
    margin-top: -48vh;
    padding-top: 14vh;
  }
  .datas__topo {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--sp-4) var(--sp-6);
    margin-bottom: var(--s-block);
  }
  .datas > .container { position: relative; }
  .datas :global(.evento) { transition: background-color var(--dur-1-2) var(--ease-ui); }
  @media (hover: hover) and (pointer: fine) {
    .datas :global(.evento:hover) { background: rgb(242 236 226 / .035); }
  }

  .datas__aurora {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 82%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 82%, transparent);
  }
  :global(.pin-ok) .datas__aurora { top: 34vh; }
  .datas__veu {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
    animation: var(--deriva) var(--duracao) var(--ease-olho) infinite alternate;
    animation-play-state: paused;
  }
  .datas__aurora[data-ativa="true"] .datas__veu,
  .datas__aurora[data-ativa="true"] .datas__onda { animation-play-state: running; }
  .datas__veu--ouro {
    --deriva: deriva-ouro;
    --duracao: 26s;
    left: -20%; top: 4%;
    width: 90vw; height: 70%;
    background: radial-gradient(closest-side, rgb(214 162 74 / .13), rgb(214 162 74 / .05) 55%, transparent);
  }
  .datas__veu--ambar {
    --deriva: deriva-ambar;
    --duracao: 34s;
    right: -25%; top: 30%;
    width: 80vw; height: 75%;
    background: radial-gradient(closest-side, rgb(184 104 47 / .12), rgb(184 104 47 / .04) 60%, transparent);
  }
  .datas__veu--lua {
    --deriva: deriva-lua;
    --duracao: 41s;
    left: 20%; bottom: -15%;
    width: 60vw; height: 50%;
    background: radial-gradient(closest-side, rgb(195 206 220 / .06), transparent);
  }
  .datas__onda {
    position: absolute;
    inset: -10% -50%;
    background: repeating-linear-gradient(100deg, transparent 0 9%, rgb(230 189 110 / .028) 12%, transparent 15% 24%);
    animation: onda-desliza 48s ease-in-out infinite alternate;
    animation-play-state: paused;
    will-change: transform;
  }
  .datas__foco {
    position: absolute;
    left: 0; top: 0;
    width: 44rem; height: 44rem;
    margin: -22rem 0 0 -22rem;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(230 189 110 / .09), transparent);
    opacity: 0;
    transition: opacity var(--dur-1) var(--ease-ui);
  }
  .datas__aurora[data-foco="true"] .datas__foco { opacity: 1; }
  @keyframes deriva-ouro {
    from { transform: translate3d(0, 0, 0) scale(1) rotate(0deg); }
    to { transform: translate3d(22vw, 8%, 0) scale(1.18) rotate(8deg); }
  }
  @keyframes deriva-ambar {
    from { transform: translate3d(0, 0, 0) scale(1.1); }
    to { transform: translate3d(-26vw, -12%, 0) scale(.92); }
  }
  @keyframes deriva-lua {
    from { transform: translate3d(0, 0, 0) scale(.9); opacity: .6; }
    to { transform: translate3d(18vw, -20%, 0) scale(1.2); opacity: 1; }
  }
  @keyframes onda-desliza {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(25%, 0, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .datas__veu, .datas__onda { animation: none; }
    .datas__foco { display: none; }
  }

  .datas__todas { gap: var(--sp-2); min-height: 44px; color: var(--gold-300); }
  .datas__lista { border-bottom: var(--borda-1); }
  .datas__vazio:not([hidden]) { display: grid; gap: var(--sp-5); justify-items: start; }

  .lente {
    position: fixed;
    left: 0; top: 0;
    z-index: var(--z-lente);
    width: 220px; height: 275px;
    margin: -137px 0 0 -110px;
    clip-path: url(#f-olho);
    pointer-events: none;
    opacity: 0;
    scale: .6;
    transition: opacity var(--dur-1-2) var(--ease-ui), scale var(--dur-1-2) var(--ease-ui);
    display: none;
  }
  .lente[data-visivel="true"] { opacity: 1; scale: 1; }
  .lente img { width: 100%; height: 100%; object-fit: cover; }
  @media (hover: hover) and (pointer: fine) and (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .lente { display: block; }
  }
</style>
