---
import { Picture } from 'astro:assets';
import jetLateral from '@/assets/fotos/jet-set/jet-lateral.jpg';
import { AVIAO_727, CAIXA_DO_AVIAO } from '@/data/formas';

interface Props {
  class?: string;
  sizes: string;
  larguras: number[];
  isAnimavel?: boolean;
}

const { class: className, sizes, larguras, isAnimavel = false } = Astro.props;
---
<span class:list={['aviao', className]} aria-hidden="true" data-cartaz-aviao-corpo={isAnimavel ? '' : undefined}>
  <span class="aviao__recorte">
    <Picture src={jetLateral} alt="" formats={['avif', 'webp']} widths={larguras} sizes={sizes} quality={60} loading="lazy" decoding="async" class="aviao__foto" />
    <span class="aviao__brilho" data-aviao-brilho></span>
  </span>
  <svg class="aviao__traco" viewBox={CAIXA_DO_AVIAO.join(' ')} focusable="false">
    {AVIAO_727.tracos.map((traco) => <path d={traco} pathLength={isAnimavel ? 1 : undefined} />)}
  </svg>
</span>

<style>
  .aviao {
    position: relative;
    display: block;
    aspect-ratio: 474 / 102;
  }
  .aviao__recorte {
    position: absolute;
    inset: 0;
    overflow: hidden;
    clip-path: url(#recorte-do-aviao);
  }
  .aviao__recorte :global(picture) { display: contents; }
  .aviao__recorte :global(.aviao__foto) {
    position: absolute;
    left: -22.785%;
    top: -70.196%;
    width: 162.03%;
    max-width: none;
    height: auto;
    transform-origin: 14.844% 34.167%;
    rotate: -10deg;
    filter: saturate(.85) contrast(1.08);
  }
  .aviao__brilho {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 35%, rgb(255 250 240 / .55) 50%, transparent 65%);
    transform: translateX(-120%);
    mix-blend-mode: soft-light;
  }
  .aviao__traco {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: var(--gold-300);
    stroke-width: 1;
    stroke-linejoin: round;
  }
  .aviao__traco path { vector-effect: non-scaling-stroke; }
</style>
