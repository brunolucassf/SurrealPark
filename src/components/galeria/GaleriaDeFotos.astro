---
import FotoAcervo from '@/components/ui/FotoAcervo.astro';
import Icone from '@/components/ui/Icone.astro';
import { AMBIENTES, carregarFotosDaGaleria } from './acervoDaGaleria';
import '@/styles/galeria.css';

const LOTE = 24;
const LARGURAS_DA_GRADE = [480, 828, 1200];
const SIZES_DA_GRADE = '(min-width: 1536px) 18vw, (min-width: 1024px) 24vw, (min-width: 640px) 33vw, 50vw';

const fotos = await carregarFotosDaGaleria();
const filtros = [
  { chave: 'todos', nome: 'Todos', total: fotos.length },
  ...AMBIENTES.map((ambiente) => ({ ...ambiente, total: fotos.filter((foto) => foto.ambiente === ambiente.chave).length })),
];
---
<section class="galeria" data-galeria data-lote={LOTE} aria-label="Fotos do parque">
  <div class="container galeria__controle">
    <div class="filtros" role="group" aria-labelledby="rotulo-filtros">
      <p class="t-mono-xs filtros__rotulo" id="rotulo-filtros">Filtrar por ambiente</p>
      <div class="filtros__trilho">
        {filtros.map((filtro) => (
          <button class="filtro" type="button" data-filtro={filtro.chave} data-nome={filtro.nome} aria-pressed={filtro.chave === 'todos' ? 'true' : 'false'}>
            <span>{filtro.nome}</span>
            <span class="filtro__contagem">{filtro.total}</span>
          </button>
        ))}
      </div>
    </div>
    <p class="t-mono-xs galeria__status" role="status" aria-live="polite" data-status></p>
  </div>

  <div class="container galeria__palco">
    <ol class="grade" role="list" data-grade>
      {fotos.map((foto, indice) => (
        <li
          class:list={['quadro', { 'quadro--paisagem': foto.isPaisagem }]}
          data-quadro
          data-ambiente={foto.ambiente}
          data-grande={foto.grande.src}
          data-largura={foto.grande.largura}
          data-altura={foto.grande.altura}
          data-alt={foto.alt}
          data-legenda={foto.legenda}
          data-fotografo={foto.fotografo ?? undefined}
          hidden={indice >= LOTE}
        >
          <button class="quadro__abrir" type="button" aria-haspopup="dialog" data-abrir>
            <FotoAcervo
              slot={foto.id}
              arquivo={foto.arquivo}
              alt={foto.alt}
              sizes={SIZES_DA_GRADE}
              larguras={LARGURAS_DA_GRADE.filter((largura) => largura <= foto.imagem.width)}
              isPrioritaria={indice < 2}
              class="quadro__imagem"
            />
          </button>
          <div class="quadro__falha" data-falha hidden>
            <p class="t-mono-xs">Não carregou.</p>
            <button class="btn btn--secundario" type="button" data-tentar-de-novo>Tentar de novo</button>
          </div>
        </li>
      ))}
    </ol>

    <div class="vazio" data-vazio hidden>
      <p class="t-lead">Nenhuma foto deste ambiente por enquanto.</p>
      <button class="btn btn--secundario" type="button" data-ver-todas>Ver todas</button>
    </div>

    <div class="mais" data-mais>
      <button class="btn btn--primario" type="button" data-ver-mais>
        Ver mais fotos
        <Icone nome="piramide" class="btn__seta" />
      </button>
      <p class="t-mono-xs mais__apoio" data-apoio-mais></p>
    </div>
  </div>

  <dialog class="lightbox" data-lightbox aria-label="Foto ampliada">
    <div class="lightbox__moldura">
      <button class="lightbox__fechar" type="button" data-fechar aria-label="Fechar">
        <Icone nome="fechar" />
      </button>
      <div class="lightbox__palco" data-palco>
        <img class="lightbox__imagem" data-imagem alt="" decoding="async" />
      </div>
      <button class="lightbox__seta lightbox__seta--anterior" type="button" data-anterior aria-label="Foto anterior">
        <Icone nome="piramide" />
      </button>
      <button class="lightbox__seta lightbox__seta--proxima" type="button" data-proxima aria-label="Próxima foto">
        <Icone nome="piramide" />
      </button>
      <div class="lightbox__rodape" aria-live="polite">
        <p class="t-mono-xs lightbox__contador" data-contador></p>
        <p class="t-body-s lightbox__legenda" data-legenda></p>
        <p class="t-mono-xs lightbox__credito" data-credito hidden></p>
      </div>
    </div>
  </dialog>
</section>

<section class="fecho container" data-humor="luar" aria-labelledby="titulo-fecho">
  <h2 class="t-h2" id="titulo-fecho">Da foto para a pista.</h2>
  <a class="btn btn--primario" href="/programacao">
    Ver próximo evento
    <Icone nome="piramide" class="btn__seta" />
  </a>
</section>

<script>
  import '@/scripts/galeria/galeria';
</script>
