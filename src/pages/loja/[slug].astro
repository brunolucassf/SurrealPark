---
import Base from '@/layouts/Base.astro';
import DefinicoesDaLoja from '@/components/loja/DefinicoesDaLoja.astro';
import IlustracaoDeProduto from '@/components/loja/IlustracaoDeProduto.astro';
import CartaoDeProduto from '@/components/loja/CartaoDeProduto.astro';
import Preco from '@/components/loja/Preco.astro';
import Icone from '@/components/ui/Icone.astro';
import Simbolo from '@/components/marca/Simbolo.astro';
import { IS_DEMONSTRACAO } from '@/data/demonstracao';
import { SUFIXO_NOVA_ABA } from '@/data/site';
import {
  buscarProdutosRelacionados,
  criarLinkWhatsAppDoProduto,
  descreverDisponibilidade,
  isLojaAtiva,
  listarProdutos,
  type ProdutoDeTela,
} from '@/lib/loja';
import { formatarPreco } from '@/data/loja';
import '@/components/loja/painel.css';
import '@/styles/loja.css';

export async function getStaticPaths() {
  if (!isLojaAtiva) return [];
  const produtos = await listarProdutos();
  return produtos.map((produto) => ({ params: { slug: produto.slug }, props: { produto, produtos } }));
}

interface Props { produto: ProdutoDeTela; produtos: ProdutoDeTela[] }

const { produto, produtos } = Astro.props;
const [corPrincipal] = produto.cores;
const corDaVitrine = corPrincipal?.base ?? 'var(--ink-800)';
const rotuloDaCategoria = produto.categoriaRotulo;
const relacionados = buscarProdutosRelacionados(produto, produtos);
const linkWhatsApp = criarLinkWhatsAppDoProduto(produto);
const isComFotos = produto.fotos.length > 0;
const vistas = produto.imagens.filter((imagem) => imagem.vista !== 'detalhe');
const quantidadeDeVistas = isComFotos ? produto.fotos.length : vistas.length;
const isGaleriaMultipla = quantidadeDeVistas > 1;
const avisoDeDisponibilidade = descreverDisponibilidade(produto.disponibilidade);
const ilustracao = corPrincipal && produto.forma ? { forma: produto.forma, cor: corPrincipal } : null;
const isEsgotado = produto.disponibilidade === 'esgotado';
const descreverVista = (rotuloDaVista: string, nomeDaCor: string) => `Ilustração de ${produto.nome}, ${rotuloDaVista.toLowerCase()}, cor ${nomeDaCor.toLowerCase()}`;

const produtoEstruturado = produto.isExemplo || IS_DEMONSTRACAO
  ? null
  : {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: produto.nome,
      description: produto.descricao,
      brand: { '@type': 'Brand', name: 'Surreal' },
      offers: {
        '@type': 'Offer',
        price: (produto.precoEmCentavos / 100).toFixed(2),
        priceCurrency: 'BRL',
        availability: isEsgotado ? 'https://schema.org/OutOfStock' : 'https://schema.org/InStoreOnly',
        url: new URL(`/loja/${produto.slug}`, Astro.site).href,
      },
    };
---
<Base
  titulo={`${produto.nome} | Surreal Store`}
  descricao={`${produto.tipo} da Surreal Store, a loja do Surreal Park. Compra e retirada apenas na loja, dentro do parque.`}
>
  {produtoEstruturado && <script slot="head" type="application/ld+json" set:html={JSON.stringify(produtoEstruturado)} />}
  <DefinicoesDaLoja />

  <article class="ficha container" data-ficha data-slug={produto.slug}>
    <nav class="ficha__trilha" aria-label="Trilha">
      <ol class="t-mono-xs" role="list">
        <li><a class="link-nav" href="/loja">Loja</a></li>
        <li><a class="link-nav" href={`/loja?categoria=${produto.categoria}#produtos`}>{rotuloDaCategoria}</a></li>
        <li aria-current="page">{produto.nome}</li>
      </ol>
    </nav>

    <div class="ficha__cabeca">
      <p class="t-mono-xs ficha__tipo">{produto.tipo}</p>
      <h1 class="t-h2 ficha__nome">{produto.nome}</h1>
      <p data-ficha-preco>
        <Preco precoEmCentavos={produto.precoEmCentavos} class="ficha__preco" />
        {produto.precoDeEmCentavos !== null && <s class="ficha__preco-de"><span class="sr-only">Preço anterior </span>{formatarPreco(produto.precoDeEmCentavos)}</s>}
        {produto.percentualDesconto !== null && <span class="produto__promocao t-mono-xs">-{produto.percentualDesconto}%</span>}
      </p>
      {IS_DEMONSTRACAO && produto.isExemplo && <span class="selo-exemplo t-mono-xs">exemplo: nome e preço fictícios</span>}
    </div>

    <div class="ficha__palco" data-ficha-palco>
      <div class="ficha__vitrine" style={`--cor-vitrine:${corDaVitrine};view-transition-name:produto-${produto.slug}`} data-inclinavel>
        <span class="ficha__fantasma" aria-hidden="true">{produto.nome.split(' ').at(-1)}</span>
        {isComFotos ? produto.fotos.map((foto, indice) => (
          <div class="ficha__vista ficha__vista--foto" id={`vista-${indice}`} data-vista={String(indice)} hidden={indice > 0}>
            <img class="ficha__foto" src={foto.url} alt={foto.alt} width={foto.largura} height={foto.altura} loading={indice === 0 ? 'eager' : 'lazy'} decoding="async" />
          </div>
        )) : ilustracao && vistas.map((imagem, indice) => (
          <div class="ficha__vista" id={`vista-${imagem.vista}`} data-vista={imagem.vista} hidden={indice > 0}>
            <IlustracaoDeProduto
              forma={ilustracao.forma}
              cor={ilustracao.cor}
              vista={imagem.vista}
              rotulo={descreverVista(imagem.rotulo, ilustracao.cor.nome)}
              class="ficha__ilustracao"
            />
          </div>
        ))}
        <span class="produto__brilho" aria-hidden="true"></span>
      </div>
      {isGaleriaMultipla && (
        <div class="ficha__miniaturas" role="group" aria-label="Vistas do produto">
          {isComFotos ? produto.fotos.map((foto, indice) => (
            <button class="ficha__miniatura" type="button" data-mostrar-vista={String(indice)} aria-controls={`vista-${indice}`} aria-pressed={indice === 0 ? 'true' : 'false'} aria-label={`Foto ${indice + 1} de ${produto.fotos.length}`}>
              <img class="ficha__miniatura-arte ficha__foto" src={foto.url} alt="" width={foto.largura} height={foto.altura} loading="lazy" decoding="async" />
            </button>
          )) : ilustracao && vistas.map((imagem, indice) => (
            <button class="ficha__miniatura" type="button" data-mostrar-vista={imagem.vista} aria-controls={`vista-${imagem.vista}`} aria-pressed={indice === 0 ? 'true' : 'false'}>
              <IlustracaoDeProduto forma={ilustracao.forma} cor={ilustracao.cor} vista={imagem.vista} class="ficha__miniatura-arte" />
              <span class="t-mono-xs ficha__miniatura-rotulo">{imagem.rotulo}</span>
            </button>
          ))}
        </div>
      )}
    </div>

    <div class="ficha__info">
      <p class="t-body ficha__descricao">{produto.descricao}</p>

      {avisoDeDisponibilidade && (
        <p class="t-body-s ficha__aviso-disponibilidade" data-esgotado={isEsgotado ? '' : undefined}>
          {isEsgotado ? 'Esgotado no momento. Pergunte pelo WhatsApp sobre reposição.' : 'Poucas unidades. Confirme na loja antes de ir.'}
        </p>
      )}

      {produto.cores.length > 0 && (
        <div class="ficha__grupo">
          <p class="t-mono-xs ficha__grupo-titulo" id="titulo-cores">Cor: <span class="ficha__cor-atual" data-cor-atual>{corPrincipal?.nome}</span></p>
          <div class="ficha__cores" role="group" aria-labelledby="titulo-cores">
            {produto.cores.map((cor, indice) => (
              <button
                class="ficha__cor"
                type="button"
                style={`--cor-amostra:${cor.base}`}
                data-cor-nome={cor.nome}
                data-cor-base={cor.base}
                data-cor-estampa={cor.estampa}
                aria-pressed={indice === 0 ? 'true' : 'false'}
                aria-label={cor.nome}
              ></button>
            ))}
          </div>
        </div>
      )}

      {produto.tamanhos.length > 0 && (
        <div class="ficha__grupo">
          <h2 class="t-mono-xs ficha__grupo-titulo">Tamanhos</h2>
          <ul class="ficha__tamanhos" role="list">
            {produto.tamanhos.map((tamanho) => <li class="ficha__tamanho">{tamanho}</li>)}
          </ul>
          <p class="t-body-s ficha__nota">A grade disponível muda a cada reposição. Confirme na loja.</p>
        </div>
      )}

      <div class="ficha__retirada">
        <Simbolo class="ficha__retirada-olho" />
        <div class="ficha__retirada-texto">
          <p class="t-body"><strong>Disponível na Surreal Store, no parque.</strong> Retire no local.</p>
          <a class="link-texto t-body-s" href="/contato#como-chegar">Como chegar ao parque</a>
        </div>
      </div>

      <div class="ficha__acoes">
        <a class="btn btn--primario btn--bloco" href={linkWhatsApp} target="_blank" rel="noopener" aria-label={`Perguntar pelo WhatsApp sobre ${produto.nome} ${SUFIXO_NOVA_ABA}`}>
          <Icone nome="whatsapp" class="btn__icone" />
          <span class="btn__texto">Perguntar pelo WhatsApp</span>
        </a>
        <p class="t-body-s ficha__nota">O site não vende on-line. Pagamento e retirada na loja.</p>
      </div>
    </div>
  </article>

  {relacionados.length > 0 && (
    <section class="relacionados container" aria-labelledby="titulo-relacionados">
      <div class="relacionados__cabeca">
        <h2 class="t-h3" id="titulo-relacionados">Mais da Surreal Store</h2>
        <a class="link-texto" href="/loja#produtos">Ver todos os produtos</a>
      </div>
      <ul class="catalogo__grade relacionados__grade" role="list" data-relacionados>
        {relacionados.map((item, indice) => <CartaoDeProduto produto={item} ordem={indice} />)}
      </ul>
    </section>
  )}
</Base>

<script>
  import { iniciarFichaDoProduto } from '@/scripts/loja/produto';
  import { sincronizarFichaComOPainel } from '@/scripts/loja/painel';
  iniciarFichaDoProduto();
  void sincronizarFichaComOPainel();
</script>
