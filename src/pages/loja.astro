---
import Base from '@/layouts/Base.astro';
import DefinicoesDaLoja from '@/components/loja/DefinicoesDaLoja.astro';
import TopoDaLoja from '@/components/loja/TopoDaLoja.astro';
import CatalogoDaLoja from '@/components/loja/CatalogoDaLoja.astro';
import RetireNoParque from '@/components/loja/RetireNoParque.astro';
import { PRODUTOS, isLojaAtiva } from '@/data/loja';
import '@/styles/loja.css';

const isCatalogoReal = isLojaAtiva && PRODUTOS.length > 0 && PRODUTOS.every((produto) => !produto.isExemplo);
const urlDaLoja = new URL('/loja', Astro.site).href;
const catalogoEstruturado = isCatalogoReal
  ? {
      '@context': 'https://schema.org',
      '@type': 'OfferCatalog',
      name: 'Surreal Store',
      url: urlDaLoja,
      itemListElement: PRODUTOS.map((produto) => ({
        '@type': 'Offer',
        url: new URL(`/loja/${produto.slug}`, Astro.site).href,
        price: (produto.precoEmCentavos / 100).toFixed(2),
        priceCurrency: 'BRL',
        availability: 'https://schema.org/InStoreOnly',
        itemOffered: { '@type': 'Product', name: produto.nome },
      })),
    }
  : null;
---
<Base
  titulo="Surreal Store, a loja do parque | Surreal Park"
  descricao="Camisetas, bonés, jaquetas e outros produtos com a marca Surreal. Veja o catálogo e compre na Surreal Store, dentro do parque."
>
  {catalogoEstruturado && <script slot="head" type="application/ld+json" set:html={JSON.stringify(catalogoEstruturado)} />}
  <DefinicoesDaLoja />
  <TopoDaLoja />
  {isLojaAtiva && <CatalogoDaLoja />}
  <RetireNoParque />
</Base>
